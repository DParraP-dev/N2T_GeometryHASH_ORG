// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Game.jack
//  Clase   : Game
//  Rol     : ORQUESTADOR central del juego. Es el "cerebro" que:
//              - mantiene el bucle principal (game loop),
//              - lee el teclado SIN bloquear (via Input),
//              - actualiza la fisica del cubo y mueve pinchos, portal y fondo,
//              - genera grupos de pinchos y, tras 5 grupos, un portal,
//              - al cruzar un portal: +1 punto, invierte colores, cambia de
//                plano (suelo <-> techo) y sube la velocidad,
//              - detecta colisiones y controla el fin de la partida.
//
//  Fases:  impares = SUELO, mundo hacia la izquierda, colores normales.
//          pares   = TECHO, mundo hacia la derecha, colores invertidos.
//
//  Constantes de pantalla Hack: 512 ancho x 256 alto.
// ============================================================================

class Game {

    field Renderer renderer;      // capa de dibujo + color actual
    field Hud hud;                // marcador y mensajes en pantalla
    field Scenery scenery;        // muescas de la superficie activa que avanzan con el mundo
    field Starfield stars;        // estrellas con paralaje detras de la accion
    field Player player;          // el cubo del jugador
    field Array pool;             // pool fijo de Spikes (se reciclan)
    field int poolSize;
    field Random rng;             // varia pinchos y distancias
    field int gap;                // px de mundo que faltan para el siguiente grupo
    field Portal portal;          // aro de transicion entre etapas
    field Array wallPool;         // pool fijo de Wall (paredes de las fases de nave)
    field int wallPoolSize;       // cantidad de paredes reutilizables en el pool
    field int stage;              // etapa actual (1, 2, 3...)
    field int spawned;            // grupos de pinchos generados en esta etapa
    field int perStage;           // grupos antes de que aparezca el portal
    field int bannerTimer;        // ticks que le quedan al cartel de fase

    // Distribucion vertical de la pantalla (filas). tools/lib/bot.mjs
    // depende de estas filas y de las columnas del cubo (cubeColumn):
    //   0..17 marcador | 18..21 techo | 22..231 zona de juego
    //   232..235 suelo | 236..255 informacion de la fase
    field int floorY;             // primera fila del suelo
    field int ceilY;              // ultima fila del techo
    field boolean roof;           // true en las fases de techo (colores invertidos)
    field int dir;                // sentido del mundo: -1 hacia la izquierda, +1 hacia la derecha
    field int score;              // puntaje acumulado
    field int speed;              // velocidad de desplazamiento (px/tick)
    field int tickDelay;          // ms de espera por tick (controla fluidez)
    field boolean running;        // true mientras la partida sigue viva

    /**
     * Construye el juego. TODOS los objetos se crean aqui, una sola vez;
     * cada partida nueva los reutiliza con reset(). Durante el juego no se
     * reserva ni se libera memoria.
     */
    constructor Game new(int seed) {
        var int i;
        let floorY = 232;
        let ceilY = 21;
        let renderer = Renderer.new();
        let hud = Hud.new(renderer);
        let scenery = Scenery.new(233);       // muescas dentro del suelo
        let rng = Random.new(seed);
        let stars = Starfield.new(rng);         // antes de reset(): no altera la secuencia de pinchos
        let player = Player.new(64, floorY, ceilY, 16); // cubo fijo a la izquierda
        let poolSize = 3;                        // nunca hay mas de 3 en pantalla
        let pool = Array.new(poolSize);
        let i = 0;
        while (i < poolSize) {
            let pool[i] = Spikes.new();
            let i = i + 1;
        }
        let portal = Portal.new(ceilY + 5, floorY - 5);   // ocupa toda la zona de juego
        let wallPoolSize = 3;                     // paredes simultaneas en las fases de nave
        let wallPool = Array.new(wallPoolSize);   // reserva el arreglo del pool (una sola vez)
        let i = 0;                                // indice para recorrer el pool
        while (i < wallPoolSize) {                // crea cada pared del pool...
            let wallPool[i] = Wall.new(ceilY + 1, floorY - 1);  // ...muro entre fila 22 y 231 (zona de juego)
            let i = i + 1;                        // avanza al siguiente hueco del pool
        }
        let perStage = 5;
        let tickDelay = 30;                      // ~33 fps aprox.
        do reset(seed);
        return this;
    }

    /** Deja todo listo para una partida nueva (Fase 1, velocidad inicial). */
    method void reset(int seed) {
        do rng.reseed(seed);
        do renderer.setInverted(false);
        let roof = false;
        let dir = -1;                            // Fase 1: el mundo viene desde la derecha
        do player.reset(cubeColumn());
        do clearWorld();
        let stage = 1;
        let bannerTimer = 0;
        let score = 0;
        let speed = 5;
        let running = true;
        do updateFlightMode();   // la etapa 1 arranca en modo salto
        return;
    }

    /**
     * Bucle principal de UNA partida (termina al chocar).
     * En cada iteracion: lee input, actualiza estado, redibuja y espera.
     * El uso de Keyboard.keyPressed() garantiza captura NO bloqueante.
     */
    method void play() {
        do drawStaticScene();

        while (running) {
            do stars.hide();          // pantalla limpia para mover y dibujar
            do tickBanner();
            do updateWorld();
            do render();
            do stars.show(speed, dir);
            do Sys.wait(tickDelay);   // ritmo del juego (y sensacion de fluidez)
        }

        do showGameOver();
        return;
    }

    /**
     * Aplica el input al cubo segun el modo. En modo salto, una pulsacion
     * inicia un salto (evento puntual). En modo nave la tecla se consume
     * dentro de player.update() como propulsion continua, asi que aqui no
     * se hace nada. El teclado se lee UNA sola vez por tick en updateWorld.
     */
    method void applyInput(boolean jumpHeld) {
        if (~player.isFlying()) {
            if (jumpHeld) { do player.jump(); }
        }
        return;
    }

    /** Avanza la simulacion: fisica del cubo, obstaculos, colisiones. */
    method void updateWorld() {
        var int i;
        var Spikes s;
        var Wall w;                             // pared auxiliar para recorrer el pool de muros
        var boolean jumpHeld;

        let jumpHeld = Input.isJump();          // lectura NO bloqueante, una vez por tick
        do applyInput(jumpHeld);                // salto (modo normal)
        do player.update(jumpHeld);             // integra fisica: salto o nave
        do scenery.scroll(speed * dir, renderer);

        // Mover los pinchos activos (se desactivan solos al salir).
        let i = 0;
        while (i < poolSize) {
            let s = pool[i];
            if (s.isActive()) { do s.move(speed * dir, renderer); }
            let i = i + 1;
        }
        // Mover las paredes activas (se desactivan solas al salir de pantalla).
        let i = 0;                              // reinicia el indice para el pool de paredes
        while (i < wallPoolSize) {              // recorre todas las paredes...
            let w = wallPool[i];                // toma la pared i
            if (w.isActive()) { do w.move(speed * dir, renderer); }  // si esta en juego, la desplaza
            let i = i + 1;                      // avanza a la siguiente
        }
        if (portal.isActive()) { do portal.move(speed * dir, renderer); }

        // Tras 'perStage' grupos aparece el portal; mientras esta en
        // pantalla no se generan pinchos.
        let gap = gap - speed;
        if ((gap < 1) & (bannerTimer = 0) & ~portal.isActive()) {
            if (spawned < perStage) {               // aun faltan obstaculos antes del portal
                if (player.isFlying()) {            // fase de nave: salen PAREDES
                    do spawnWall();
                } else {                            // fase normal: salen los PINCHOS de siempre
                    do spawnSpikes();
                }
            } else {                                // ya salieron todos: aparece el portal
                do portal.spawn(spawnX(portal.getWidth()));
            }
        }
        do checkPortal();

        if (collides()) {
            let running = false;   // colision -> fin de la partida
        }
        return;
    }

    /**
     * Columna donde nace un objeto de ancho w: justo fuera de la pantalla,
     * en el borde por donde entra el mundo (derecha en el suelo, izquierda
     * en el techo).
     */
    method int spawnX(int w) {
        if (dir < 0) { return 512; }
        return -w;
    }

    /**
     * Genera un grupo de pinchos en el borde de entrada, reutilizando un
     * objeto libre del pool, y sortea la distancia hasta el siguiente.
     */
    method void spawnSpikes() {
        var int i, count;
        var boolean tall;
        var Spikes s;
        let i = 0;
        while (i < poolSize) {
            let s = pool[i];
            if (~s.isActive()) {
                let count = 1 + rng.below(3);                 // 1 a 3 pinchos
                let tall = (count < 3) & (rng.below(4) = 0);  // 1 de cada 4 es alto
                if (roof) { do s.spawn(spawnX(count * 16), count, tall, ceilY, false); }
                else      { do s.spawn(spawnX(count * 16), count, tall, floorY, true); }
                let spawned = spawned + 1;
                // Separacion minima = ancho del grupo + un salto completo
                // (~16 ticks en el aire) + margen, mas un extra aleatorio.
                let gap = (s.getWidth() + (speed * 18)) + (16 + rng.below(120));
                return;
            }
            let i = i + 1;
        }
        let gap = 16;   // pool lleno: reintentar pronto
        return;
    }

    /**
     * Genera una pared en el borde de entrada (fases de nave), reutilizando
     * una pared libre del pool. El hueco se sortea al azar y se ACOTA a la
     * zona jugable con margen de 16 px arriba y abajo, de modo que siempre
     * sea atravesable. En vuelo no se salta, asi que la separacion entre
     * paredes es mas corta y constante que la de los pinchos.
     */
    method void spawnWall() {
        var int i, gapTopRow, lo, range;        // indice, fila del hueco y limites del sorteo
        var Wall w;                             // pared del pool que vamos a usar
        let i = 0;                              // empieza a buscar desde la primera pared
        while (i < wallPoolSize) {              // recorre el pool buscando una libre...
            let w = wallPool[i];                // toma la pared i
            if (~w.isActive()) {                // si esta libre, la usamos
                let lo = (ceilY + 1) + 16;      // fila minima del hueco: tope de juego + margen (38)
                let range = ((floorY - 1) - 16) - w.getGapHeight() - lo + 1;  // nro de filas posibles (133)
                let gapTopRow = lo + rng.below(range);   // sortea el borde superior del hueco y lo acota
                do w.spawn(spawnX(w.getWidth()), gapTopRow);   // crea la pared fuera de pantalla con ese hueco
                let spawned = spawned + 1;      // cuenta un obstaculo mas en esta fase
                // Separacion en vuelo: ancho de la pared + un tramo fijo + extra aleatorio.
                let gap = (w.getWidth() + (speed * 20)) + (24 + rng.below(60));  // distancia hasta la proxima
                return;                         // pared colocada: salimos
            }
            let i = i + 1;                      // esa estaba ocupada: prueba la siguiente
        }
        let gap = 16;   // pool lleno: reintentar pronto (igual que spawnSpikes)
        return;
    }

    /** Cuenta atras del cartel de fase; al llegar a 0 lo borra. */
    method void tickBanner() {
        if (bannerTimer > 0) {
            let bannerTimer = bannerTimer - 1;
            if (bannerTimer = 0) { do hud.eraseBanner(); }
        }
        return;
    }

    /** Detecta si el centro del portal ya paso el centro del cubo. */
    method void checkPortal() {
        var int pc;
        if (portal.isActive()) {
            let pc = player.getX() + (player.getSize() / 2);
            if ((dir < 0) & (portal.centerX() < pc)) { do enterPortal(); return; }
            if ((dir > 0) & (portal.centerX() > pc)) { do enterPortal(); }
        }
        return;
    }

    /**
     * Cruce del portal: +1 punto, INVERSION DE COLORES y cambio de plano.
     *  - Colores: cada clase pide "tinta" o "fondo" al Renderer, asi que
     *    toda la escena se invierte con un solo toggleInvert().
     *  - Plano: la accion pasa del suelo al techo (o al reves), la gravedad
     *    del cubo se invierte y el mundo cambia de sentido. En el techo el
     *    cubo queda a la derecha y avanza de derecha a izquierda.
     */
    method void enterPortal() {
        let score = score + 1;
        let stage = stage + 1;
        if (speed < 20) { let speed = speed + 1; }   // cada etapa es mas rapida (tope seguro)
        do renderer.toggleInvert();
        let roof = ~roof;
        let dir = -dir;
        do player.flip(cubeColumn());
        do updateFlightMode();        // activa modo nave en etapas multiplo de 5
        do clearWorld();              // los pinchos ya superados desaparecen
        do drawStaticScene();         // el respiro lo da el cartel de fase
        return;
    }

    /**
     * Decide el modo del cubo segun la etapa: las etapas multiplo de 5
     * (5, 10, 15...) son FASES DE NAVE (vuelo tipo Geometry Dash); el resto
     * usan el salto clasico. Jack no tiene operador modulo, asi que el
     * "stage mod 5" se calcula como stage - ((stage / 5) * 5), igual que en
     * Random. Mientras no haya obstaculos de nave, estas fases sirven para
     * probar el vuelo de forma aislada.
     */
    method void updateFlightMode() {
        var boolean fly;
        let fly = ((stage - ((stage / 5) * 5)) = 0);
        do player.setFlying(fly);
        return;
    }

    /** Columna fija del cubo: 64 en el suelo, 432 (lado derecho) en el techo. */
    method int cubeColumn() {
        if (roof) { return 512 - 64 - 16; }
        return 64;
    }

    /** Saca de juego pinchos y portal y reinicia el conteo de la etapa. */
    method void clearWorld() {
        var int i;
        var Spikes s;
        var Wall w;   // pared auxiliar para recorrer el pool de muros
        let i = 0;
        while (i < poolSize) {
            let s = pool[i];
            do s.deactivate();
            let i = i + 1;
        }
        do portal.deactivate();
        let i = 0;                        // reinicia el indice para el pool de paredes
        while (i < wallPoolSize) {        // recorre todas las paredes...
            let w = wallPool[i];          // toma la pared i del pool
            do w.deactivate();            // la saca de juego (al cambiar de fase)
            let i = i + 1;                // avanza a la siguiente
        }
        let spawned = 0;
        let gap = 0;
        return;
    }

    /**
     * Colision del cubo contra cualquier grupo de pinchos activo
     * (solapamiento de rectangulos, AABB, calculado en Spikes.hits).
     */
    method boolean collides() {
        var int i, px, py, ps;
        var Spikes s;
        var Wall w;                       // pared auxiliar para recorrer el pool de muros
        let px = player.getX();           // esquina X del cubo
        let py = player.getY();           // esquina Y del cubo
        let ps = player.getSize();        // lado del cubo
        let i = 0;                        // indice del pool de pinchos
        while (i < poolSize) {            // revisa colision contra cada grupo de pinchos...
            let s = pool[i];              // toma el grupo i
            if (s.hits(px, py, ps)) {     // si el cubo toca estos pinchos...
                return true;              // ...hay colision: fin de partida
            }
            let i = i + 1;                // siguiente grupo
        }
        let i = 0;                        // reinicia el indice para el pool de paredes
        while (i < wallPoolSize) {        // revisa colision contra cada pared (fases de nave)...
            let w = wallPool[i];          // toma la pared i
            if (w.hits(px, py, ps)) {     // si el cubo toca una franja de la pared...
                return true;              // ...hay colision: fin de partida
            }
            let i = i + 1;                // siguiente pared
        }
        return false;                     // no toco nada: sigue vivo
    }

    /** Dibuja elementos fijos de la escena (suelo) y limpia el fondo. */
    method void drawStaticScene() {
        do renderer.clearBackground();
        do stars.forget();            // el fondo limpio ya no tiene estrellas
        // Suelo: franja fina a lo ancho de la pantalla.
        do renderer.fillRect(0, ceilY - 3, 511, ceilY);     // techo
        do renderer.fillRect(0, floorY, 511, floorY + 3);   // suelo
        if (roof) { do scenery.setRow(ceilY - 2); } else { do scenery.setRow(floorY + 1); }
        do scenery.draw(renderer);
        do hud.drawScene(score, speed - 4, stage, roof);
        do hud.drawBanner(stage, roof);
        let bannerTimer = 45;         // ~1.5 s sin pinchos para reaccionar
        return;
    }

    /**
     * Redibuja los elementos moviles. El marcador no se toca aqui: antes se
     * imprimia "Puntaje: " en cada tick y cada literal reservaba un String
     * nuevo que nunca se liberaba. El heap se agotaba (ERR6) a los ~570
     * ticks de juego. Ahora Hud lo dibuja solo cuando el puntaje cambia.
     */
    method void render() {
        do player.render(renderer);   // los pinchos se dibujan al moverse
        return;
    }

    /** Pantalla de fin de partida con el puntaje final. */
    method void showGameOver() {
        do hud.drawGameOver(score);
        return;
    }

    /** Libera toda la memoria del juego. */
    method void dispose() {
        var int i;
        var Spikes s;
        var Wall w;   // pared auxiliar para liberar el pool de muros
        let i = 0;
        while (i < poolSize) {
            let s = pool[i];
            do s.dispose();
            let i = i + 1;
        }
        do pool.dispose();
        let i = 0;                        // reinicia el indice para liberar paredes
        while (i < wallPoolSize) {        // recorre el pool de paredes...
            let w = wallPool[i];          // toma la pared i
            do w.dispose();               // libera la pared (y sus franjas Strips)
            let i = i + 1;                // avanza a la siguiente
        }
        do wallPool.dispose();            // libera el arreglo del pool
        do portal.dispose();
        do rng.dispose();
        do player.dispose();
        do hud.dispose();
        do scenery.dispose();
        do stars.dispose();
        do renderer.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
