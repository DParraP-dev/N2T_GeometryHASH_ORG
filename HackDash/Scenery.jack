// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Scenery.jack
//  Clase   : Scenery
//  Rol     : Fondo en movimiento. El techo y el suelo tienen muescas (huecos
//            con el color de fondo) que se desplazan a la velocidad del
//            mundo, como una cinta transportadora. La pantalla siempre
//            transmite avance aunque no haya pinchos a la vista (requisito
//            "Fondo Movil / Entorno Dinamico").
//
//  Las muescas miden 12 px y se repiten cada 64 px, de modo que basta un
//  desplazamiento 'offset' en [0, 64) para describir todo el riel:
//      muesca k en la columna  k * 64 + offset   (k = -1 .. 7)
//  Mientras offset no da la vuelta, cada muesca se mueve con shiftSpan en
//  modo hueco (dos rectangulos delgados). Al dar la vuelta se repinta todo.
// ============================================================================

class Scenery {

    field int offset;      // desplazamiento actual, en [0, 64)
    field int topRow;      // primera fila de las muescas del techo (2 px de alto)
    field int bottomRow;   // primera fila de las muescas del suelo

    constructor Scenery new(int top, int bottom) {
        let offset = 0;
        let topRow = top;
        let bottomRow = bottom;
        return this;
    }

    /** Abre las muescas (hole = true) o las vuelve a rellenar (false). */
    method void paint(Renderer r, boolean hole) {
        var int k, x;
        let k = -1;
        while (k < 8) {
            let x = (k * 64) + offset;
            do r.paintRect(x, topRow, x + 11, topRow + 1, ~hole);
            do r.paintRect(x, bottomRow, x + 11, bottomRow + 1, ~hole);
            let k = k + 1;
        }
        return;
    }

    /** Abre las muescas sobre el techo y el suelo recien pintados. */
    method void draw(Renderer r) {
        do paint(r, true);
        return;
    }

    /** Desplaza las muescas dx columnas (negativo = izquierda). */
    method void scroll(int dx, Renderer r) {
        var int k, x, next;
        let next = offset + dx;
        if ((next > -1) & (next < 64)) {
            let k = -1;
            while (k < 8) {
                let x = (k * 64) + offset;
                do r.shiftSpan(x, x + 11, x + dx, (x + 11) + dx, topRow, topRow + 1, false);
                do r.shiftSpan(x, x + 11, x + dx, (x + 11) + dx, bottomRow, bottomRow + 1, false);
                let k = k + 1;
            }
            let offset = next;
            return;
        }
        // Dio la vuelta: rellenar, volver a [0, 64) y abrir de nuevo.
        do paint(r, false);
        if (next < 0) { let offset = next + 64; } else { let offset = next - 64; }
        do paint(r, true);
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
