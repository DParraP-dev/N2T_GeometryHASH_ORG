// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Scenery.jack
//  Clase   : Scenery
//  Rol     : Fondo en movimiento. La superficie activa (suelo o techo) tiene
//            muescas (huecos con el color de fondo) que se desplazan a la
//            velocidad del mundo, como una cinta transportadora. La pantalla
//            siempre transmite avance aunque no haya pinchos a la vista
//            (requisito "Fondo Movil / Entorno Dinamico"). Solo se mueve la
//            superficie activa: la mitad de trabajo por tick, y ademas indica
//            al jugador en que plano esta.
//
//  Las muescas miden 12 px y se repiten cada 64 px, de modo que basta un
//  desplazamiento 'offset' en [0, 64) para describir todo el riel:
//      muesca k en la columna  k * 64 + offset   (k = -1 .. 7)
//  Mientras offset no da la vuelta, cada muesca se mueve con shiftSpan en
//  modo hueco (dos rectangulos delgados). Al dar la vuelta se repinta todo.
// ============================================================================

class Scenery {

    field int offset;      // desplazamiento actual, en [0, 64)
    field int row;         // primera fila de las muescas (2 px de alto)

    constructor Scenery new(int startRow) {
        let offset = 0;
        let row = startRow;
        return this;
    }

    /** Cambia la superficie con muescas (se llama antes de repintar). */
    method void setRow(int newRow) {
        let row = newRow;
        return;
    }

    /** Abre las muescas (hole = true) o las vuelve a rellenar (false). */
    method void paint(Renderer r, boolean hole) {
        var int k, x;
        let k = -1;
        while (k < 8) {
            let x = (k * 64) + offset;
            do r.paintRect(x, row, x + 11, row + 1, ~hole);
            let k = k + 1;
        }
        return;
    }

    /** Abre las muescas sobre la superficie recien pintada. */
    method void draw(Renderer r) {
        do paint(r, true);
        return;
    }

    /** Desplaza las muescas dx columnas (negativo = izquierda). */
    method void scroll(int dx, Renderer r) {
        var int k, x, next;
        let next = offset + dx;
        if ((next > -1) & (next < 64)) {
            let k = -1;
            while (k < 8) {
                let x = (k * 64) + offset;
                do r.shiftSpan(x, x + 11, x + dx, (x + 11) + dx, row, row + 1, false);
                let k = k + 1;
            }
            let offset = next;
            return;
        }
        // Dio la vuelta: rellenar, volver a [0, 64) y abrir de nuevo.
        do paint(r, false);
        if (next < 0) { let offset = next + 64; } else { let offset = next - 64; }
        do paint(r, true);
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
