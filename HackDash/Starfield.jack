// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Starfield.jack
//  Clase   : Starfield
//  Rol     : Fondo en movimiento con paralaje. Estrellas en forma de X cruzan
//            la zona de juego mas despacio que el mundo: las lejanas miden
//            3x3 px y van a 1/4 de la velocidad; las cercanas miden 5x5 px y
//            van a 1/2. La diferencia de ritmos da profundidad.
//
//                lejana      cercana
//                 # #       #   #
//                  #         # #
//                 # #         #
//                            # #
//                           #   #
//
//  Las estrellas se dibujan con XOR directo sobre la memoria de pantalla:
//  invertir dos veces el mismo pixel lo deja como estaba. Game las OCULTA al
//  empezar el tick (la pantalla queda exactamente como sin estrellas), mueve
//  y dibuja todo lo demas, y las MUESTRA al final. Asi nunca dejan huecos en
//  pinchos, portal o cubo, y con los colores invertidos salen solas en el
//  color contrario.
//
//  Memoria de pantalla Hack: la fila y empieza en 16384 + 32 * y; cada
//  palabra cubre 16 columnas y el bit 0 es la columna mas a la izquierda.
//  Cada fila de una X son 1 o 2 pixeles alrededor de la columna central;
//  las tablas guardan, para cada columna central p (0..15), los bits que
//  caen en la palabra propia y en las vecinas, sin desplazamientos en vivo.
// ============================================================================

class Starfield {

    field Array col, pos;     // palabra de pantalla (0..31) y columna central dentro de ella (0..15)
    field Array row;          // direccion de la fila central: 16384 + 32 * y
    field Array bit;          // bit[k] = 2^k (bit 15 = signo)
    field Array outL, outM, outR;   // fila "#   #": bits en la palabra izquierda, propia y derecha
    field Array inL, inM, inR;      // fila " # # "
    field Array midM;               // fila "  #  " (nunca sale de la palabra)
    field Array none;               // sin bits: vecinas de la fila central
    field Array screen;       // memoria de pantalla
    field int count;          // total de estrellas
    field int far;            // las primeras 'far' son lejanas; el resto, cercanas
    field boolean shown;      // true si las estrellas estan pintadas ahora mismo

    constructor Starfield new(Random rng) {
        var int i;
        let count = 10;
        let far = 5;
        let screen = 0;
        let col = Array.new(count);
        let pos = Array.new(count);
        let row = Array.new(count);
        let bit = Array.new(16);
        let bit[0] = 1;
        let i = 1;
        while (i < 16) {
            let bit[i] = bit[i - 1] + bit[i - 1];   // en i = 15 desborda a -32768: el bit de signo
            let i = i + 1;
        }
        let outL = Array.new(16); let outM = Array.new(16); let outR = Array.new(16);
        let inL = Array.new(16);  let inM = Array.new(16);  let inR = Array.new(16);
        let midM = Array.new(16);
        let none = Array.new(16);
        do fill(outL, outM, outR, 2);
        do fill(inL, inM, inR, 1);
        let i = 0;
        while (i < 16) {
            let midM[i] = bit[i];
            let none[i] = 0;
            let i = i + 1;
        }
        let i = 0;
        while (i < count) {
            let col[i] = rng.below(32);
            let pos[i] = rng.below(16);
            let row[i] = 16384 + ((28 + rng.below(198)) * 32);   // filas centrales 28..225
            let i = i + 1;
        }
        let shown = false;
        return this;
    }

    /** Tablas de la fila con pixeles en p - d y p + d. */
    method void fill(Array left, Array mid, Array right, int d) {
        var int p;
        let p = 0;
        while (p < 16) {
            let left[p] = 0;
            let mid[p] = 0;
            let right[p] = 0;
            if (p < d) { let left[p] = bit[(p - d) + 16]; } else { let mid[p] = bit[p - d]; }
            if (p > (15 - d)) { let right[p] = bit[(p + d) - 16]; } else { let mid[p] = mid[p] | bit[p + d]; }
            let p = p + 1;
        }
        return;
    }

    /** La pantalla se acaba de limpiar: las estrellas ya no estan pintadas. */
    method void forget() {
        let shown = false;
        return;
    }

    /** Invierte una fila de la X: la palabra propia y, en los bordes, la vecina. */
    method void flipRow(int a, int c, int p, Array left, Array mid, Array right) {
        var int m, v;
        let m = mid[p];
        let v = screen[a];
        let screen[a] = (v | m) & (~(v & m));
        if ((p < 2) & (c > 0)) {
            let m = left[p];
            let v = screen[a - 1];
            let screen[a - 1] = (v | m) & (~(v & m));
        }
        if ((p > 13) & (c < 31)) {
            let m = right[p];
            let v = screen[a + 1];
            let screen[a + 1] = (v | m) & (~(v & m));
        }
        return;
    }

    /** Invierte la estrella i en su posicion actual (dibujar = borrar). */
    method void flipStar(int i) {
        var int a, c, p;
        let c = col[i];
        let p = pos[i];
        let a = row[i] + c;
        if (i < far) {
            do flipRow(a - 32, c, p, inL, inM, inR);
            do flipRow(a, c, p, none, midM, none);
            do flipRow(a + 32, c, p, inL, inM, inR);
            return;
        }
        do flipRow(a - 64, c, p, outL, outM, outR);
        do flipRow(a - 32, c, p, inL, inM, inR);
        do flipRow(a, c, p, none, midM, none);
        do flipRow(a + 32, c, p, inL, inM, inR);
        do flipRow(a + 64, c, p, outL, outM, outR);
        return;
    }

    /** Quita las estrellas, dejando la pantalla como estaba antes de mostrarlas. */
    method void hide() {
        var int i;
        if (shown) {
            let i = 0;
            while (i < count) {
                do flipStar(i);
                let i = i + 1;
            }
            let shown = false;
        }
        return;
    }

    /**
     * Avanza las estrellas segun la velocidad del mundo (speed px/tick en el
     * sentido dir) y las vuelve a pintar. La columna se guarda como
     * (palabra, bit) para no dividir entre 16 en cada tick.
     */
    method void show(int speed, int dir) {
        var int i, p, c, step, nearStep, farStep;
        let nearStep = (speed / 2) * dir;
        let farStep = (speed / 4) * dir;
        if (farStep = 0) { let farStep = dir; }
        let i = 0;
        while (i < count) {
            if (i < far) { let step = farStep; } else { let step = nearStep; }
            let p = pos[i] + step;
            let c = col[i];
            if (p > 15) { let p = p - 16; let c = c + 1; }   // |step| <= 10: a lo sumo una palabra
            if (p < 0)  { let p = p + 16; let c = c - 1; }
            if (c > 31) { let c = 0; }
            if (c < 0)  { let c = 31; }
            let pos[i] = p;
            let col[i] = c;
            do flipStar(i);
            let i = i + 1;
        }
        let shown = true;
        return;
    }

    method void dispose() {
        do col.dispose();
        do pos.dispose();
        do row.dispose();
        do bit.dispose();
        do outL.dispose(); do outM.dispose(); do outR.dispose();
        do inL.dispose();  do inM.dispose();  do inR.dispose();
        do midM.dispose();
        do none.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
