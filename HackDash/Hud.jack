// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Hud.jack
//  Clase   : Hud
//  Rol     : Interfaz en pantalla (marcador, velocidad, fase y carteles).
//            Sabe DONDE va cada texto; el COMO se dibuja lo resuelve Font.
//
//  Memoria: todos los textos fijos se crean UNA vez en el constructor y se
//  reutilizan. El Memory.alloc del OS no fusiona bloques libres, asi que
//  crear y liberar Strings en cada escena iria fragmentando el heap.
//
//  Rendimiento: nada se redibuja en cada tick. Game llama a drawScore() o
//  drawScene() solo cuando un valor cambia.
// ============================================================================

class Hud {

    field Renderer renderer;
    field String sPoints, sSpeed, sStage, sFloor, sRoof, sJump, sGameOver, sRetry;

    constructor Hud new(Renderer r) {
        let renderer = r;
        let sPoints = "PUNTOS";
        let sSpeed = "VELOCIDAD";
        let sStage = "FASE";
        let sFloor = "SUELO";
        let sRoof = "TECHO INVERTIDO";
        let sJump = "ESPACIO: SALTAR";
        let sGameOver = "GAME OVER";
        let sRetry = "ESPACIO: REINTENTAR";
        return this;
    }

    /** Dibuja toda la interfaz de una escena recien limpiada. */
    method void drawScene(int score, int level, int stage, boolean roof) {
        var int x;
        do Font.drawText(renderer, sPoints, 8, 4, 2);
        do drawScore(score);
        do Font.drawText(renderer, sSpeed, 400, 4, 2);
        do Font.drawNumber(renderer, level, 478, 4, 2);
        // Barra inferior: fase actual y control.
        let x = Font.drawText(renderer, sStage, 8, 242, 2);
        let x = Font.drawNumber(renderer, stage, x + 8, 242, 2);
        if (roof) { do Font.drawText(renderer, sRoof, x + 16, 242, 2); }
        else      { do Font.drawText(renderer, sFloor, x + 16, 242, 2); }
        do Font.drawText(renderer, sJump, 386, 242, 2);
        return;
    }

    /** Borra la caja del numero y escribe el puntaje nuevo. */
    method void drawScore(int score) {
        do renderer.eraseRect(62, 4, 109, 13);
        do Font.drawNumber(renderer, score, 62, 4, 2);
        return;
    }

    /**
     * Cartel grande al empezar cada fase, centrado en la zona de juego.
     * Queda lejos de las columnas del cubo (64 y 432) para no taparlo.
     */
    method void drawBanner(int stage, boolean roof) {
        var int x;
        let x = Font.drawText(renderer, sStage, 202, 100, 4);
        do Font.drawNumber(renderer, stage, x + 16, 100, 4);
        if (roof) { do Font.drawText(renderer, sRoof, 197, 128, 2); }
        else      { do Font.drawText(renderer, sFloor, 237, 128, 2); }
        return;
    }

    method void eraseBanner() {
        do renderer.eraseRect(190, 96, 350, 140);   // cabe una fase de 3 cifras
        return;
    }

    /** Cartel de fin de partida en el centro de la pantalla. */
    method void drawGameOver(int score) {
        var int x;
        do renderer.fillRect(136, 78, 375, 177);       // marco
        do renderer.eraseRect(140, 82, 371, 173);      // interior
        do Font.drawText(renderer, sGameOver, 186, 94, 4);
        let x = Font.drawText(renderer, sPoints, 220, 128, 2);
        do Font.drawNumber(renderer, score, x + 8, 128, 2);
        do Font.drawText(renderer, sRetry, 181, 152, 2);
        return;
    }

    method void dispose() {
        do sPoints.dispose();
        do sSpeed.dispose();
        do sStage.dispose();
        do sFloor.dispose();
        do sRoof.dispose();
        do sJump.dispose();
        do sGameOver.dispose();
        do sRetry.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
