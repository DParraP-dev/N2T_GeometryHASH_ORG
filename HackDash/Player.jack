// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Player.jack
//  Clase   : Player
//  Rol     : Representa el cubo controlado por el jugador. Encapsula su
//            posicion, su tamano y su FISICA de salto (cinematica con
//            gravedad), cumpliendo el requisito "Comportamiento Fisico
//            Modelado" de la rubrica.
//
//  Modelo fisico (cinematica vertical discreta):
//    En cada tick se aplica:   vy <- vy + gravity
//                              y  <- y  + vy
//    Al saltar se fija vy a un impulso negativo (hacia arriba en pantalla,
//    donde y crece hacia abajo). La gravedad lo frena y lo devuelve al
//    suelo, generando un arco parabolico -> rebote calculado matematicamente.
//
//  Gravedad con sentido (dir):
//    dir = +1 : fases de SUELO. La gravedad tira hacia abajo y el cubo se
//               apoya sobre el suelo.
//    dir = -1 : fases de TECHO. La gravedad tira hacia arriba, el cubo
//               cuelga del techo y "salta" hacia abajo.
//  Las mismas dos ecuaciones sirven para ambos casos multiplicando la
//  gravedad y el impulso por dir:  vy <- vy + g*dir ;  salto: vy = -imp*dir
//
//  Coordenadas: la X del cubo es FIJA (el mundo se mueve, no el cubo), lo
//  que refuerza la sensacion de "fondo movil". Solo varia Y.
// ============================================================================

class Player {

    field int x, y;          // Esquina superior-izquierda del cubo (px)
    field int prevY;         // Y del tick anterior (para borrar solo lo necesario)
    field int size;          // Lado del cubo (cuadrado) en px
    field int vy;            // Velocidad vertical actual (px/tick)
    field int gravity;       // Aceleracion de la gravedad (px/tick^2)
    field int jumpImpulse;   // Rapidez inicial del salto (px/tick)
    field int floorY;        // Primera fila del suelo (el cubo apoya encima)
    field int ceilY;         // Ultima fila del techo (el cubo cuelga debajo)
    field int dir;           // +1 gravedad hacia abajo, -1 hacia arriba
    field boolean onGround;  // true si el cubo esta apoyado en su superficie
    field boolean flying;    // true en las fases de nave (modo vuelo tipo Geometry Dash)
    field int thrust;        // empuje por tick mientras se mantiene la tecla (px/tick^2)
    field int maxVy;         // tope de |vy| en modo nave (evita tunneling vertical)

    /**
     * Crea el cubo apoyado en el suelo.
     *  startX : posicion horizontal fija del cubo.
     *  floor  : primera fila del suelo.
     *  ceil   : ultima fila del techo.
     *  s      : lado del cubo.
     */
    constructor Player new(int startX, int floor, int ceil, int s) {
        let x = startX;
        let size = s;
        let floorY = floor;
        let ceilY = ceil;
        let dir = 1;
        let y = floorY - size;  // apoyado justo encima del suelo
        let prevY = y;
        let vy = 0;
        let gravity = 2;        // caida rapida: el salto se siente seco, no flotante
        let jumpImpulse = 16;   // altura maxima = 16+14+...+2 = 72 px, ~16 ticks en el aire
        let onGround = true;
        let flying = false;     // por defecto modo salto
        let thrust = 4;         // empuje neto = thrust - gravity: sube y baja al mismo ritmo
        let maxVy = 8;          // velocidad vertical maxima controlable
        return this;
    }

    /** Vuelve al estado inicial (en el suelo, en la columna startX). */
    method void reset(int startX) {
        let x = startX;
        let dir = 1;
        let vy = 0;
        let onGround = true;
        let y = floorY - size;
        let prevY = y;
        return;
    }

    /**
     * Cambio de plano al cruzar un portal: invierte la gravedad, coloca el
     * cubo en su nueva superficie y en la nueva columna newX.
     */
    method void flip(int newX) {
        let dir = -dir;
        let x = newX;
        let vy = 0;
        let onGround = true;
        if (dir = 1) { let y = floorY - size; } else { let y = ceilY + 1; }
        let prevY = y;
        return;
    }

    method int getX()    { return x; }
    method int getY()    { return y; }
    method int getSize() { return size; }

    /** Inicia un salto solo si el cubo esta en el suelo (evita doble salto). */
    method void jump() {
        if (onGround) {
            let vy = -(jumpImpulse * dir);   // contra la gravedad
            let onGround = false;
        }
        return;
    }

    /** Activa o desactiva el modo nave. Lo controla Game segun la etapa. */
    method void setFlying(boolean value) {
        let flying = value;
        let vy = 0;
        return;
    }

    method boolean isFlying() { return flying; }

    /**
     * Avanza un paso la simulacion fisica.
     *  jumpHeld : estado de la tecla de salto EN ESTE tick (lo pasa Game).
     *
     * Modo salto (flying = false): jumpHeld no se usa aqui (el salto es un
     * evento puntual via jump()); solo se integra gravedad y se aterriza.
     *
     * Modo nave (flying = true): mientras la tecla esta pulsada se aplica un
     * empuje continuo contra la gravedad (asciende); al soltar, la gravedad
     * lo hace descender. vy se acota a [-maxVy, maxVy] para que el cubo no
     * cruce la pantalla en un solo tick (tunneling vertical). Tocar el borde
     * frena el cubo (vy = 0) en vez de matarlo: la fase de nave se esquiva
     * con los obstaculos, no con los bordes.
     */
    method void update(boolean jumpHeld) {
        let prevY = y;

        if (flying) {
            if (jumpHeld) { let vy = vy - (thrust * dir); }  // propulsion contra la gravedad
            let vy = vy + (gravity * dir);                   // gravedad, igual que el salto
            // Clamp de vy al rango [-maxVy, maxVy].
            if (vy > maxVy)    { let vy = maxVy; }
            if (vy < (-maxVy)) { let vy = -maxVy; }
        } else {
            let vy = vy + (gravity * dir);  // la gravedad tira hacia su superficie
        }

        let y = y + vy;                     // actualiza posicion vertical

        // Topes: el cubo nunca atraviesa el suelo ni el techo.
        if ((y + size) > floorY) {
            let y = floorY - size;
            let vy = 0;
            let onGround = (dir = 1);
        }
        if (y < (ceilY + 1)) {
            let y = ceilY + 1;
            let vy = 0;
            let onGround = (dir = -1);
        }
        return;
    }

    /**
     * Dibuja el cubo con el color de tinta actual. drawRectangle incluye
     * ambos extremos, por eso el lado va de x a x + size - 1: asi el cubo
     * mide exactamente 'size' px y nunca pisa la fila del suelo.
     * Los ojos son dos huecos con el color de fondo que miran hacia donde
     * avanza el mundo; en el techo el cubo va de cabeza (ojos abajo).
     */
    method void draw(Renderer r) {
        var int ex, ey;
        do r.fillRect(x, y, (x + size) - 1, (y + size) - 1);
        if (dir = 1) { let ex = x + 8; let ey = y + 4; }   // mira a la derecha
        else         { let ex = x + 2; let ey = y + 8; }   // mira a la izquierda, de cabeza
        do r.eraseRect(ex, ey, ex + 1, ey + 3);
        do r.eraseRect(ex + 4, ey, ex + 5, ey + 3);
        return;
    }

    /**
     * Redibuja el cubo tras update(). En vez de borrar el cubo entero,
     * borra solo la banda de filas que dejo libre al moverse y luego lo
     * pinta en su nueva posicion: no parpadea al saltar.
     */
    method void render(Renderer r) {
        var int x2;
        let x2 = (x + size) - 1;
        if (y > prevY) {   // bajo: queda libre la parte de arriba
            do r.eraseRect(x, prevY, x2, Math.min(y, prevY + size) - 1);
        }
        if (y < prevY) {   // subio: queda libre la parte de abajo
            do r.eraseRect(x, Math.max(y + size, prevY), x2, (prevY + size) - 1);
        }
        do draw(r);
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
