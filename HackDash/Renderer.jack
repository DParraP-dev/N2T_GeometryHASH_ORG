// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Renderer.jack
//  Clase   : Renderer
//  Rol     : Capa de abstraccion sobre la libreria Screen del OS de Jack.
//            Centraliza TODO el dibujado del juego en un unico lugar.
//
//  Por que existe esta clase:
//    El diferenciador del juego es la INVERSION DE COLORES en tiempo real
//    (fondo blanco/elementos negros  <->  fondo negro/elementos blancos).
//    Para que esa inversion sea trivial y no haya que tocar cada clase,
//    Renderer es la UNICA fuente de verdad sobre "cual es el color de
//    tinta (elementos) y cual es el color de fondo" en cada momento.
//
//    La pantalla Hack mide 256 filas (alto) x 512 columnas (ancho) y es
//    monocromatica: Screen.setColor(true) pinta negro, false pinta blanco.
// ============================================================================

class Renderer {

    field boolean inverted;   // false = fondo blanco / tinta negra (Fase 1)
                              // true  = fondo negro  / tinta blanca (Fase 2)

    /** Crea el renderer en el esquema de color inicial (Fase 1). */
    constructor Renderer new() {
        let inverted = false;
        return this;
    }

    /** Alterna el esquema de color. Lo invoca Game al cruzar un portal. */
    method void toggleInvert() {
        let inverted = ~inverted;   // '~' sobre un boolean = NOT logico
        return;
    }

    /** Devuelve true si el juego esta en modo invertido (Fase 2). */
    method boolean isInverted() {
        return inverted;
    }

    /** Color de los ELEMENTOS (cubo, obstaculos, suelo, texto). */
    method boolean inkColor() {
        // No invertido: tinta negra (true). Invertido: tinta blanca (false).
        return ~inverted;
    }

    /** Color del FONDO. Es el opuesto a la tinta. */
    method boolean bgColor() {
        return inverted;
    }

    /** Pinta toda la pantalla con el color de fondo actual. */
    method void clearBackground() {
        do Screen.setColor(bgColor());
        do Screen.drawRectangle(0, 0, 511, 255);
        return;
    }

    // ------------------------------------------------------------------
    //  Recorte (clamp) de coordenadas.
    //
    //  IMPORTANTE: Screen.drawRectangle del OS de Jack es ESTRICTO. Si
    //  cualquier coordenada cae fuera de la pantalla (x: 0..511, y: 0..255)
    //  lanza el error "ERR9" (Illegal rectangle coordinates) y detiene el
    //  programa. Como el cubo puede saltar por encima del borde superior y
    //  los obstaculos salen por los bordes laterales, TODO dibujo pasa por
    //  aqui para recortarse al area visible antes de llamar al OS.
    // ------------------------------------------------------------------

    /** Limita un valor X al rango horizontal valido [0, 511]. */
    method int clampX(int v) {
        if (v < 0)   { return 0; }
        if (v > 511) { return 511; }
        return v;
    }

    /** Limita un valor Y al rango vertical valido [0, 255]. */
    method int clampY(int v) {
        if (v < 0)   { return 0; }
        if (v > 255) { return 255; }
        return v;
    }

    /**
     * Dibuja un rectangulo (relleno) ya recortado a la pantalla.
     * Si el rectangulo queda COMPLETAMENTE fuera, no dibuja nada.
     */
    method void safeRect(int x1, int y1, int x2, int y2) {
        // Descartar si esta por completo fuera del area visible.
        if ((x2 < 0) | (x1 > 511) | (y2 < 0) | (y1 > 255)) {
            return;
        }
        do Screen.drawRectangle(clampX(x1), clampY(y1), clampX(x2), clampY(y2));
        return;
    }

    /** Dibuja un rectangulo relleno usando el color de la TINTA. */
    method void fillRect(int x1, int y1, int x2, int y2) {
        do Screen.setColor(inkColor());
        do safeRect(x1, y1, x2, y2);
        return;
    }

    /** Borra (pinta con el FONDO) un rectangulo. Util para limpiar sprites. */
    method void eraseRect(int x1, int y1, int x2, int y2) {
        do Screen.setColor(bgColor());
        do safeRect(x1, y1, x2, y2);
        return;
    }

    // ------------------------------------------------------------------
    //  Dibujo incremental (sin parpadeo).
    //
    //  Borrar un objeto completo y volver a pintarlo en cada tick hace que
    //  parpadee y cuesta 2 rectangulos del tamano del objeto. Cuando una
    //  franja horizontal se desplaza unos pocos pixeles, basta con pintar
    //  el borde que ENTRA y borrar el borde que SALE: dos rectangulos
    //  delgados de 'speed' pixeles de ancho, y el resto queda intacto.
    // ------------------------------------------------------------------

    /** Pinta un rectangulo con tinta (ink = true) o con fondo (false). */
    method void paintRect(int x1, int y1, int x2, int y2, boolean ink) {
        if (ink) { do fillRect(x1, y1, x2, y2); } else { do eraseRect(x1, y1, x2, y2); }
        return;
    }

    /**
     * Mueve una franja de las columnas [ox1..ox2] a [nx1..nx2] en las filas
     * y1..y2, tocando solo los pixeles que cambian. Funciona en ambos
     * sentidos. Si la franja salto mas que su propio ancho (no hay
     * solapamiento), borra la vieja y pinta la nueva.
     * ink = true mueve una franja de tinta; ink = false mueve un HUECO
     * (franja de fondo dentro de una zona pintada), con los colores al reves.
     */
    method void shiftSpan(int ox1, int ox2, int nx1, int nx2, int y1, int y2, boolean ink) {
        if ((nx1 > ox2) | (nx2 < ox1)) {
            do paintRect(ox1, y1, ox2, y2, ~ink);
            do paintRect(nx1, y1, nx2, y2, ink);
            return;
        }
        if (nx1 < ox1) { do paintRect(nx1, y1, ox1 - 1, y2, ink); }    // entra por la izquierda
        if (nx1 > ox1) { do paintRect(ox1, y1, nx1 - 1, y2, ~ink); }   // sale por la izquierda
        if (nx2 > ox2) { do paintRect(ox2 + 1, y1, nx2, y2, ink); }    // entra por la derecha
        if (nx2 < ox2) { do paintRect(nx2 + 1, y1, ox2, y2, ~ink); }   // sale por la derecha
        return;
    }

    /** Mueve una franja de tinta (pinchos, portal). */
    method void moveSpan(int ox1, int ox2, int nx1, int nx2, int y1, int y2) {
        do shiftSpan(ox1, ox2, nx1, nx2, y1, y2, true);
        return;
    }

    /** Libera el objeto. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
