// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Font.jack
//  Clase   : Font
//  Rol     : Fuente de mapa de bits propia (3x5 pixeles por letra) que se
//            dibuja con rectangulos a traves de Renderer.
//
//  Por que no usamos Output:
//    Output.printString del OS pinta letras NEGRAS sobre una celda BLANCA.
//    Al invertir los colores (fondo negro) cada letra quedaria dentro de una
//    caja blanca. Esta fuente pinta con el color de "tinta" del Renderer, asi
//    que el texto se invierte junto con todo lo demas.
//
//  Codificacion: cada letra es un entero de 15 bits. El bit 14 es el pixel
//  (fila 0, columna 0) y se recorre por filas de 3 columnas:
//      "A" = 010 101 111 101 101 = 11245
//  Cabe en un int de Jack (maximo 32767) y la tabla ocupa 64 palabras.
//
//  Memoria: los literales de texto ("ABC") reservan un String nuevo cada vez
//  que se evaluan. drawLabel() libera el String al terminar para que dibujar
//  texto no deje basura en el heap.
// ============================================================================

class Font {

    static Array glyphs;   // glyphs[c - 32] = mapa de bits del caracter c

    /** Construye la tabla de letras. Se llama una sola vez desde Main. */
    function void init() {
        var int i;
        let glyphs = Array.new(64);
        let i = 0;
        while (i < 64) {               // Memory.alloc no limpia la memoria
            let glyphs[i] = 0;
            let i = i + 1;
        }
        do Font.set(33, 9346);   // !
        do Font.set(45, 448);    // -
        do Font.set(46, 2);      // .
        do Font.set(48, 31599);  // 0
        do Font.set(49, 11415);  // 1
        do Font.set(50, 29671);  // 2
        do Font.set(51, 29647);  // 3
        do Font.set(52, 23497);  // 4
        do Font.set(53, 31183);  // 5
        do Font.set(54, 31215);  // 6
        do Font.set(55, 29266);  // 7
        do Font.set(56, 31727);  // 8
        do Font.set(57, 31695);  // 9
        do Font.set(58, 1040);   // :
        do Font.set(65, 11245);  // A
        do Font.set(66, 27566);  // B
        do Font.set(67, 14627);  // C
        do Font.set(68, 27502);  // D
        do Font.set(69, 31143);  // E
        do Font.set(70, 31140);  // F
        do Font.set(71, 14699);  // G
        do Font.set(72, 23533);  // H
        do Font.set(73, 29847);  // I
        do Font.set(74, 4714);   // J
        do Font.set(75, 23469);  // K
        do Font.set(76, 18727);  // L
        do Font.set(77, 24557);  // M
        do Font.set(78, 27501);  // N
        do Font.set(79, 11114);  // O
        do Font.set(80, 27556);  // P
        do Font.set(81, 11123);  // Q
        do Font.set(82, 27565);  // R
        do Font.set(83, 14478);  // S
        do Font.set(84, 29842);  // T
        do Font.set(85, 23407);  // U
        do Font.set(86, 23402);  // V
        do Font.set(87, 23549);  // W
        do Font.set(88, 23213);  // X
        do Font.set(89, 23186);  // Y
        do Font.set(90, 29351);  // Z
        return;
    }

    function void set(int c, int bits) {
        let glyphs[c - 32] = bits;
        return;
    }

    /** Ancho en pixeles de un texto de 'len' caracteres. */
    function int width(int len, int scale) {
        return ((len * 4) - 1) * scale;
    }

    /**
     * Dibuja un caracter con la tinta actual. (x, y) es la esquina superior
     * izquierda; cada pixel de la letra mide scale x scale.
     * Los pixeles encendidos contiguos de una fila se unen en un solo
     * rectangulo: como maximo 2 llamadas a Screen por fila.
     */
    function void drawChar(Renderer r, int c, int x, int y, int scale) {
        var int bits, mask, row, col, runStart, top, bottom;
        if ((c > 96) & (c < 123)) { let c = c - 32; }   // minuscula -> mayuscula
        if ((c < 32) | (c > 95)) { return; }
        let bits = glyphs[c - 32];
        let mask = 16384;                                 // bit 14
        let row = 0;
        while (row < 5) {
            let top = y + (row * scale);
            let bottom = (top + scale) - 1;
            let col = 0;
            let runStart = -1;
            while (col < 3) {
                if ((bits & mask) = 0) {
                    if (runStart > -1) {
                        do r.fillRect(x + (runStart * scale), top, (x + (col * scale)) - 1, bottom);
                        let runStart = -1;
                    }
                } else {
                    if (runStart < 0) { let runStart = col; }
                }
                let mask = mask / 2;
                let col = col + 1;
            }
            if (runStart > -1) {
                do r.fillRect(x + (runStart * scale), top, (x + (3 * scale)) - 1, bottom);
            }
            let row = row + 1;
        }
        return;
    }

    /** Dibuja un String sin liberarlo. Devuelve la X donde termina. */
    function int drawText(Renderer r, String s, int x, int y, int scale) {
        var int i, n;
        let n = s.length();
        let i = 0;
        while (i < n) {
            do Font.drawChar(r, s.charAt(i), x, y, scale);
            let x = x + (4 * scale);
            let i = i + 1;
        }
        return x;
    }

    /**
     * Dibuja un texto y LIBERA el String. Pensado para literales:
     *     do Font.drawLabel(r, "PUNTOS", 8, 4, 2);
     */
    function int drawLabel(Renderer r, String s, int x, int y, int scale) {
        let x = Font.drawText(r, s, x, y, scale);
        do s.dispose();
        return x;
    }

    /** Dibuja un entero (sin reservar memoria). Devuelve la X final. */
    function int drawNumber(Renderer r, int n, int x, int y, int scale) {
        var int div, d;
        if (n < 0) {
            do Font.drawChar(r, 45, x, y, scale);         // signo '-'
            let x = x + (4 * scale);
            let n = -n;
        }
        let div = 1;
        while ((n / div) > 9) { let div = div * 10; }     // mayor potencia de 10
        while (div > 0) {
            let d = n / div;
            do Font.drawChar(r, 48 + d, x, y, scale);
            let n = n - (d * div);
            let div = div / 10;
            let x = x + (4 * scale);
        }
        return x;
    }
}
