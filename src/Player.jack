// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Player.jack
//  Clase   : Player
//  Rol     : Representa el cubo controlado por el jugador. Encapsula su
//            posicion, su tamano y su FISICA de salto (cinematica con
//            gravedad), cumpliendo el requisito "Comportamiento Fisico
//            Modelado" de la rubrica.
//
//  Modelo fisico (cinematica vertical discreta):
//    En cada tick se aplica:   vy <- vy + gravity
//                              y  <- y  + vy
//    Al saltar se fija vy a un impulso negativo (hacia arriba en pantalla,
//    donde y crece hacia abajo). La gravedad lo frena y lo devuelve al
//    suelo, generando un arco parabolico -> rebote calculado matematicamente.
//
//  Coordenadas: la X del cubo es FIJA en Fase 1 (el mundo se mueve, no el
//  cubo), lo que refuerza la sensacion de "fondo movil". Solo varia Y.
// ============================================================================

class Player {

    field int x, y;          // Esquina superior-izquierda del cubo (px)
    field int size;          // Lado del cubo (cuadrado) en px
    field int vy;            // Velocidad vertical actual (px/tick)
    field int gravity;       // Aceleracion de la gravedad (px/tick^2)
    field int jumpImpulse;   // Impulso inicial del salto (negativo = arriba)
    field int groundY;       // Coordenada Y del suelo (tope inferior util)
    field boolean onGround;  // true si el cubo esta apoyado en el suelo

    /**
     * Crea el cubo.
     *  startX  : posicion horizontal fija del cubo.
     *  gY      : Y de la superficie (suelo en Fase 1).
     *  s       : lado del cubo.
     */
    constructor Player new(int startX, int gY, int s) {
        let x = startX;
        let size = s;
        let groundY = gY;
        let y = gY - s;        // apoyado justo encima del suelo
        let vy = 0;
        let gravity = 1;       // valores pequenos: la pantalla es de 256px
        let jumpImpulse = -11; // fuerza del salto (ajustable en playtesting)
        let onGround = true;
        return this;
    }

    method int getX()    { return x; }
    method int getY()    { return y; }
    method int getSize() { return size; }

    /** Inicia un salto solo si el cubo esta en el suelo (evita doble salto). */
    method void jump() {
        if (onGround) {
            let vy = jumpImpulse;
            let onGround = false;
        }
        return;
    }

    /**
     * Avanza un paso la simulacion fisica.
     * Integra gravedad y velocidad, y resuelve la colision con el suelo.
     */
    method void update() {
        let vy = vy + gravity;   // la gravedad siempre tira hacia el suelo
        let y = y + vy;          // actualiza posicion vertical

        // Colision con el suelo: no dejar que atraviese la superficie.
        if ((y + size) > groundY) {
            let y = groundY - size;
            let vy = 0;
            let onGround = true;
        }
        return;
    }

    /** Dibuja el cubo con el color de tinta actual. */
    method void draw(Renderer r) {
        do r.fillRect(x, y, x + size, y + size);
        return;
    }

    /** Borra el cubo (pinta con el fondo) para redibujarlo en el tick. */
    method void erase(Renderer r) {
        do r.eraseRect(x, y, x + size, y + size);
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
