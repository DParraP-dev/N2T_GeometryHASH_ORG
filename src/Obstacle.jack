// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Obstacle.jack
//  Clase   : Obstacle
//  Rol     : Un obstaculo que el jugador debe esquivar saltando. Se desplaza
//            horizontalmente a traves de la pantalla; al salir por un borde
//            se RECICLA (vuelve a aparecer por el borde opuesto). Reciclar
//            en vez de crear/destruir evita fragmentar la memoria (RAM de
//            la plataforma Hack es muy limitada).
//
//  El movimiento continuo de los obstaculos es la base del requisito
//  "Fondo Movil / Entorno Dinamico": generan la sensacion de avance.
// ============================================================================

class Obstacle {

    field int x, y;        // esquina superior-izquierda (px)
    field int width;       // ancho del obstaculo
    field int height;      // alto del obstaculo
    field int groundY;     // Y de la superficie sobre la que se apoya
    field boolean active;  // true si esta visible/colisionable

    /**
     * Crea un obstaculo apoyado sobre la superficie dada.
     *  startX : X inicial (normalmente fuera de pantalla, a la derecha).
     *  gY     : Y del suelo sobre el que se asienta.
     *  w, h   : dimensiones del obstaculo.
     */
    constructor Obstacle new(int startX, int gY, int w, int h) {
        let width = w;
        let height = h;
        let groundY = gY;
        let x = startX;
        let y = gY - h;      // apoyado sobre la superficie
        let active = true;
        return this;
    }

    method int getX()      { return x; }
    method int getY()      { return y; }
    method int getWidth()  { return width; }
    method int getHeight() { return height; }
    method boolean isActive() { return active; }

    /** Reposiciona el obstaculo (al reciclarlo) en una nueva X. */
    method void resetTo(int newX) {
        let x = newX;
        let y = groundY - height;
        let active = true;
        return;
    }

    /**
     * Mueve el obstaculo 'speed' px hacia la izquierda (Fase 1).
     * Devuelve true si salio completamente por el borde izquierdo
     * (senal para que Game lo recicle y sume oportunidad de puntaje).
     */
    method boolean moveLeft(int speed) {
        let x = x - speed;
        if ((x + width) < 0) {
            return true;   // fuera de pantalla por la izquierda
        }
        return false;
    }

    /** Ajusta la superficie de apoyo (se usa al invertir suelo<->techo). */
    method void setGroundY(int gY) {
        let groundY = gY;
        let y = gY - height;
        return;
    }

    method void draw(Renderer r) {
        do r.fillRect(x, y, x + width, y + height);
        return;
    }

    method void erase(Renderer r) {
        do r.eraseRect(x, y, x + width, y + height);
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
