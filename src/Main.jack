// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Main.jack
//  Clase   : Main
//  Rol     : Punto de entrada del programa. La plataforma Nand2Tetris
//            ejecuta siempre Main.main() al iniciar. Aqui se construye
//            el objeto Game y se delega en el todo el ciclo de vida del
//            juego. Main se mantiene minimo a proposito (patron de
//            "entry point delgado").
// ============================================================================

class Main {

    /** Punto de entrada estandar exigido por el OS de Jack. */
    function void main() {
        var Game game;
        let game = Game.new();   // Construye el orquestador del juego
        do game.run();           // Cede el control al bucle principal
        do game.dispose();       // Libera memoria al terminar la partida
        return;
    }
}
