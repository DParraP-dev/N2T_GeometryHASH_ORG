// ============================================================================
//  GeometryHash  -  Juego "Hack Dash"
//  Organizacion de Computadores - 2026
//
//  Archivo : Game.jack
//  Clase   : Game
//  Rol     : ORQUESTADOR central del juego. Es el "cerebro" que:
//              - mantiene el bucle principal (game loop),
//              - lee el teclado SIN bloquear (Keyboard.keyPressed),
//              - actualiza la fisica del jugador y de los obstaculos,
//              - detecta colisiones,
//              - lleva el puntaje y lo dibuja,
//              - controla el estado de la partida (jugando / game over).
//
//  Nota de version: esta es la FASE 1 (desplazamiento horizontal inferior,
//  salto sobre el suelo). El portal, la inversion de colores y la Fase 2
//  (techo + direccion inversa + velocidad progresiva) se anaden despues.
//  Las piezas de arquitectura (Renderer con inversion, Obstacle.setGroundY)
//  ya estan preparadas para esa evolucion.
//
//  Constantes de pantalla Hack: 512 ancho x 256 alto.
// ============================================================================

class Game {

    field Renderer renderer;      // capa de dibujo + color actual
    field Player player;          // el cubo del jugador
    field Obstacle obstacle;      // obstaculo activo (Fase 1: uno a la vez)

    field int groundY;            // Y de la superficie del suelo
    field int score;              // puntaje acumulado
    field int speed;              // velocidad de desplazamiento (px/tick)
    field int tickDelay;          // ms de espera por tick (controla fluidez)
    field boolean running;        // true mientras la partida sigue viva

    /** Construye el juego y todos sus componentes en estado inicial. */
    constructor Game new() {
        let groundY = 220;                       // suelo cerca del borde inferior
        let renderer = Renderer.new();
        let player = Player.new(60, groundY, 14); // cubo fijo a la izquierda
        let obstacle = Obstacle.new(511, groundY, 12, 24);
        let score = 0;
        let speed = 4;
        let tickDelay = 30;                      // ~33 fps aprox.
        let running = true;
        return this;
    }

    /**
     * Bucle principal del juego.
     * En cada iteracion: lee input, actualiza estado, redibuja y espera.
     * El uso de Keyboard.keyPressed() garantiza captura NO bloqueante.
     */
    method void run() {
        do drawStaticScene();

        while (running) {
            do handleInput();
            do updateWorld();
            do render();
            do Sys.wait(tickDelay);   // ritmo del juego (y sensacion de fluidez)
        }

        do showGameOver();
        return;
    }

    /** Lectura NO bloqueante del teclado. Espacio (32) o flecha arriba (131). */
    method void handleInput() {
        var char key;
        let key = Keyboard.keyPressed();
        if ((key = 32) | (key = 131)) {   // barra espaciadora o flecha arriba
            do player.jump();
        }
        return;
    }

    /** Avanza la simulacion: fisica del cubo, obstaculos, colisiones. */
    method void updateWorld() {
        var boolean recycled;

        do player.erase(renderer);
        do obstacle.erase(renderer);

        do player.update();                     // integra gravedad/salto

        let recycled = obstacle.moveLeft(speed); // desplaza el obstaculo
        if (recycled) {
            // El obstaculo se esquivo con exito: punto y reaparicion.
            let score = score + 1;
            do obstacle.resetTo(511);
        }

        if (collides()) {
            let running = false;   // colision -> fin de la partida
        }
        return;
    }

    /**
     * Deteccion de colision por solapamiento de rectangulos (AABB)
     * entre el cubo y el obstaculo.
     */
    method boolean collides() {
        var int px, py, ps;
        var int ox, oy, ow, oh;
        let px = player.getX();
        let py = player.getY();
        let ps = player.getSize();
        let ox = obstacle.getX();
        let oy = obstacle.getY();
        let ow = obstacle.getWidth();
        let oh = obstacle.getHeight();

        // Hay colision solo si se solapan en ambos ejes a la vez.
        if ((px < (ox + ow)) & ((px + ps) > ox) &
            (py < (oy + oh)) & ((py + ps) > oy)) {
            return true;
        }
        return false;
    }

    /** Dibuja elementos fijos de la escena (suelo) y limpia el fondo. */
    method void drawStaticScene() {
        do renderer.clearBackground();
        // Suelo: franja fina a lo ancho de la pantalla.
        do renderer.fillRect(0, groundY, 511, groundY + 3);
        return;
    }

    /** Redibuja los elementos moviles y el marcador. */
    method void render() {
        do player.draw(renderer);
        do obstacle.draw(renderer);
        do drawScore();
        return;
    }

    /** Marcador visible y actualizado dinamicamente (requisito de rubrica). */
    method void drawScore() {
        do Output.moveCursor(0, 0);
        do Output.printString("Puntaje: ");
        do Output.printInt(score);
        return;
    }

    /** Pantalla de fin de partida con el puntaje final. */
    method void showGameOver() {
        do Output.moveCursor(10, 25);
        do Output.printString("GAME OVER");
        do Output.moveCursor(12, 22);
        do Output.printString("Puntaje final: ");
        do Output.printInt(score);
        return;
    }

    /** Libera toda la memoria del juego. */
    method void dispose() {
        do player.dispose();
        do obstacle.dispose();
        do renderer.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
